# Generated by scripts/prepare-arch-package.py from an exact Git revision.
pkgname=lginputswitch
pkgver=@VERSION@
pkgrel=1
pkgdesc='LG monitor input switching with a Qt tray and linked KDE shortcuts (beta)'
arch=('x86_64')
url='https://github.com/phillip9933/LGInputSwitch'
license=('AGPL-3.0-or-later')
depends=('qt6-base' 'kglobalaccel' 'ddcutil')
makedepends=('cmake' 'gcc' 'make')
checkdepends=('python' 'desktop-file-utils')
optdepends=('qt6-wayland: native Wayland window integration')
source=('lginputswitch-source.tar.gz')
sha256sums=('@SHA256@')

build() {
    cmake -S "$srcdir/LGInputSwitch" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DLG_BUILD_DESKTOP=ON -DLG_REQUIRE_KDE_SHORTCUTS=ON
    cmake --build "$srcdir/build" --parallel 2
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
    desktop-file-validate "$srcdir/LGInputSwitch/desktop/lginputswitch.desktop"
}

package() {
    # Qt binaries can require symbols from the version used at build time.
    depends[0]="qt6-base>=$(pkg-config --modversion Qt6Core)"
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm644 "$srcdir/LGInputSwitch/SOURCE_REVISION" \
        "$pkgdir/usr/share/doc/LGInputSwitch/SOURCE_REVISION"
}
