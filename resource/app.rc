            VALUE "ProductName", "LG Input Switch"
            VALUE "ProductVersion", "1.3.4"
            VALUE "LegalCopyright", "Copyright (c) 2025-2026 phillip9933 and contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
